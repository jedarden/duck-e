# DUCK-E Environment Configuration

# Required: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Weather tools use Open-Meteo; no weather API key is required.

# Realtime session tuning (natural turn-taking; field paths verified 2026-11-12)
# Semantic turn-detection eagerness: low | medium | high | auto.
# Invalid values fall back to auto.
REALTIME_VAD_EAGERNESS=auto
# Input noise reduction: near_field | far_field, or off to disable.
# Invalid values fall back to near_field.
REALTIME_NOISE_REDUCTION=near_field
# Input transcription model.
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Google OAuth Configuration (optional - enables user authentication and memory keying)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT Configuration (required for OAuth)
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated IPs/CIDRs allowed to supply x-forwarded-user/email.
# Leave empty unless the reverse proxy strips client-supplied identity headers
# and writes authenticated values. Example: TRUSTED_PROXY_SOURCES=10.42.0.0/16
TRUSTED_PROXY_SOURCES=

# Rate Limiting Configuration
# NOTE: Using in-memory storage (single instance only)
# Session state is lost on server restart - this is acceptable
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STATUS=60/minute
RATE_LIMIT_MAIN_PAGE=30/minute
RATE_LIMIT_WEBSOCKET=5/minute
RATE_LIMIT_WEATHER_API=10/hour
RATE_LIMIT_WEB_SEARCH=5/hour

# Cost Protection Configuration
# NOTE: Using in-memory storage (single instance only)
# Cost tracking resets on server restart - this is acceptable
COST_PROTECTION_ENABLED=true
COST_PROTECTION_MAX_SESSION_COST_USD=5.0
COST_PROTECTION_MAX_SESSION_DURATION_MINUTES=30
COST_PROTECTION_MAX_TOTAL_COST_PER_HOUR_USD=50.0
COST_PROTECTION_CIRCUIT_BREAKER_THRESHOLD_USD=100.0

# Security Configuration (optional)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# ENABLE_HSTS=true
# CSP_REPORT_URI=/csp-report

# Monitoring (optional)
ENABLE_METRICS=true

# Grafana (required when using either monitoring Compose stack)
# Replace both values before starting Prometheus/Grafana; neither has a default.
GRAFANA_ADMIN_USER=replace_with_unique_operator_username
GRAFANA_ADMIN_PASSWORD=replace_with_strong_unique_password
